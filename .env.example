# ============================================================================
# FINMAN — environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# NEVER commit a real .env (it is gitignored). Generate strong secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ---- Core server ----------------------------------------------------------
# Port the app listens on (host port in docker-compose mirrors this).
PORT=3000
# development | production. In production the secrets below are REQUIRED
# (validateEnv() and config.js fail-fast instead of auto-generating dev keys).
NODE_ENV=production

# Operators who may set exchange rates by hand (POST /api/currency/rate).
# The rate table is shared by every user. Comma-separated emails; empty = nobody.
ADMIN_EMAILS=

# ---- Secrets (REQUIRED in production) -------------------------------------
# JWT signing secret for Passport-JWT auth tokens.
#   gen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-32-byte-hex
# express-session cookie secret.
#   gen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-byte-hex
# AES-256 key for encrypting stored bank API tokens. MUST be 64 hex chars (32 bytes).
#   gen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars

# ---- Database -------------------------------------------------------------
# SQLite file path. Default for local dev is ./data/finance.db (legacy name).
# In Docker this is forced to /app/data/finman.db — the file the production
# volume `finman-data` already holds. Backups land in <dir>/backups/.
DATABASE_PATH=./data/finance.db

# ---- CORS / cookies (optional) ---------------------------------------------
# Comma-separated list of allowed browser origins. capacitor://localhost and
# http://localhost (Capacitor iOS/Android shells) are ALWAYS allowed in addition.
# Unset in dev -> http://localhost:3000 is added; unset in prod -> only the shells.
# CORS_ORIGIN=https://app.finman.money,https://finman.money
# Domain attribute of the `finman.sid` session cookie. Unset = host-only cookie.
# COOKIE_DOMAIN=.finman.money
# Public base URL — used as the bank OAuth redirect_uri base (services/bankApiService.js).
# APP_URL=https://app.finman.money

# ---- Logging (optional) ---------------------------------------------------
# pino log level: trace|debug|info|warn|error|fatal|silent. Default: info.
# LOG_LEVEL=info

# ---- AI assistant (optional — AI endpoints answer 503 until configured) ----
# Provider-agnostic layer in lib/ai/provider.js (axios only, no vendor SDKs).
# Product LLMs: Google Gemini (API key or OAuth), Ollama Cloud, any OpenAI-compatible
# server. Anthropic is an explicit opt-in only and never a default.
#
# AI_PROVIDER: google | gemini-oauth | ollama | openai | anthropic
# Leave it EMPTY to auto-detect from the keys below, in this order:
#   google (GOOGLE_API_KEY / AI_API_KEY) -> gemini-oauth -> ollama -> openai
AI_PROVIDER=
# Generic key for the chosen provider (google by default). Provider-specific
# variables below take precedence when set.
AI_API_KEY=
# Model id override (provider defaults: gemini-2.5-flash | gpt-oss:20b | gpt-4o-mini).
AI_MODEL=
# Base URL override for the env provider: a local Ollama (http://localhost:11434),
# an OpenAI-compatible gateway, or a Gemini proxy. Empty = provider default.
AI_BASE_URL=
# Max output tokens per answer (default 1024).
# AI_MAX_TOKENS=1024

# -- google: Gemini REST with an API key (aistudio.google.com) --
# GOOGLE_API_KEY=

# -- gemini-oauth: Gemini through a Google OAuth refresh token (cloudcode-pa) --
# Needs the OAuth client that issued the refresh token plus the token itself,
# either inline or as the json file written by the Gemini CLI login.
# GEMINI_CLIENT_ID=
# GEMINI_CLIENT_SECRET=
# GEMINI_REFRESH_TOKEN=
# GEMINI_OAUTH_CREDS=/home/app/.gemini-home/.gemini/oauth_creds.json

# -- ollama: Ollama Cloud (https://ollama.com) or a local server via AI_BASE_URL --
# Key from env, or read from a file (default ~/.ollama/api_key outside tests).
# OLLAMA_API_KEY=
# OLLAMA_API_KEY_FILE=/home/app/.ollama/api_key

# -- openai: OpenAI or any compatible endpoint (set AI_BASE_URL for gateways) --
# OPENAI_API_KEY=

# -- anthropic (optional opt-in): AI_PROVIDER=anthropic + key --
# ANTHROPIC_API_KEY=

# ---- Bank auto-sync (optional) --------------------------------------------
# Master switch for scheduled bank synchronization (Monobank/Revolut/Tinkoff).
# Set to "true" to enable; per-bank access tokens are added by each user in-app
# (stored encrypted with ENCRYPTION_KEY). Manual CSV import works without this.
SYNC_ENABLED=false

# ---- Billing / Stripe (optional — billing stays disabled until set) -------
# Stripe secret key (sk_live_... / sk_test_...). Required for the billing
# (subscription tier upgrade) flow; without it billing endpoints are inactive.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...) for verifying webhook events.
STRIPE_WEBHOOK_SECRET=

# ---- Demo / staging instance (optional) -----------------------------------
# DEMO_MODE marks the instance as a demo: /api/health returns demo:true and
# billing/AI answers carry _meta.demo so the UI can show "Demo instance".
# DEMO_MODE=1
# DEMO_SEED_ON_EMPTY: at boot, after migrations, if the users table is EMPTY,
# create the demo household (user `demo`, 3 accounts, ~190 transactions over
# 6 months, budgets, goals, car loan, TFSA portfolio, family). Meant for the
# staging host whose SQLite resets on every deploy. A DB with any user is never
# touched, so a second boot on the same file seeds nothing. NEVER on production.
# DEMO_SEED_ON_EMPTY=1
# Password for the demo accounts `demo` / `demo-partner` (default finman-demo-2026).
# DEMO_PASSWORD=finman-demo-2026

# ---- Password hashing (optional) ------------------------------------------
# bcrypt cost for NEW password hashes (default 12, same as app.finman.money).
# Existing hashes verify at any cost, so changing this never locks anyone out.
# BCRYPT_ROUNDS=12

# ---- Google sign-in (optional — button hidden until both are set) ----------
# OAuth 2.0 Web client from Google Cloud Console. The authorized redirect URI
# must equal GOOGLE_CALLBACK_URL (prod: https://app.finman.money/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://app.finman.money/api/auth/google/callback
# Where the browser lands after Google sign-in; the JWT travels in #token=.
# GOOGLE_SUCCESS_REDIRECT=https://app.finman.money/

# ---- Outgoing mail via Resend (optional) ----------------------------------
# Used by the email digest and by the sign-up notification below.
# Without the key every mail is a logged no-op; nothing fails.
RESEND_API_KEY=
# Default sender for app mail (digest). Must be a verified Resend domain.
# MAIL_FROM=FinMan <noreply@finman.app>

# ---- Sign-up notification to the operator (optional) ----------------------
# Every new account (password or Google) emails the operator via Resend
# (RESEND_API_KEY above). Without the key it is only logged.
# Recipients, comma-separated.
# LEAD_NOTIFY_TO=ctmakc@gmail.com
# Sender for this mail only; wins over MAIL_FROM. Keep the "INNOVA Leads" name:
# that format reaches the inbox where a plain English subject went to spam.
# LEAD_NOTIFY_FROM=INNOVA Leads <leads@remolda.com>
# GA4 Measurement Protocol: also send an anonymous sign_up event (no user data).
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=
