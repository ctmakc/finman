{
    "name": "finance-manager",
    "version": "1.0.0",
    "description": "Self-hosted personal finance manager with an AI CFO, bank imports and multi-currency net worth",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "android:sync": "npx cap sync android",
        "android:open": "npx cap open android",
        "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
        "android:release": "npx cap sync android && cd android && ./gradlew assembleRelease",
        "ios:sync": "npx cap sync ios",
        "ios:open": "npx cap open ios",
        "cap:sync": "npx cap sync"
    },
    "keywords": [
        "finance",
        "budget",
        "expenses",
        "bank-api"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.4.0",
        "bcrypt": "^5.1.0",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "express-session": "^1.17.3",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.4.1",
        "passport": "^0.6.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pdfkit": "^0.19.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "sqlite3": "^5.1.6",
        "stripe": "^22.2.2",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@capacitor/android": "^8.0.2",
        "@capacitor/cli": "^8.0.2",
        "@capacitor/core": "^8.0.2",
        "@capacitor/ios": "^8.0.2",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.5.2",
        "nodemon": "^3.1.9",
        "supertest": "^7.2.2"
    },
    "engines": {
        "node": ">=22"
    }
}
